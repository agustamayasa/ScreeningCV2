# ScreeningCV2 (Rekruta) - Deployment Environment Variables
# Copy this file to deploy.env and fill in your values.

# --- Required ---
GEMINI_API_KEY=

# --- Google OAuth Credentials ---
# Option 1: Base64-encoded credentials JSON (recommended for servers)
GOOGLE_CREDENTIALS_BASE64=

# Option 2: Individual OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Optional SSH overrides ---
# REMOTE_SSH_HOST=example.com
# REMOTE_SSH_PORT=22
# REMOTE_SSH_USER=ubuntu
# REMOTE_SSH_KEY=
